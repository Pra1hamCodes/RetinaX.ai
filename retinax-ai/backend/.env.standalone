# Standalone-mode environment — used when running the backend directly on
# the host (no Docker, no Postgres, no Redis). Sources:
#   $env:DOTENV_FILE = "./.env.standalone"
# or set in app.config via Settings(_env_file=...).

ENVIRONMENT=development
LOG_LEVEL=INFO

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost
API_V1_PREFIX=/api/v1

JWT_SECRET_KEY=standalone-dev-secret-change-me-for-real-deployment-7f3a9b2e
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_COOKIE_NAME=retinax_access
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=lax

# SQLite — file lives at backend/storage/retinax.db
DATABASE_URL=sqlite:///./storage/retinax.db

# Redis / Celery aren't used in standalone mode but the settings still parse.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE_URL=/storage

ML_MODELS_DIR=./ml/models
ML_DATA_DIR=../../dataset/colored_images
ML_TRAIN_CSV=../../dataset/train.csv
ML_METRICS_DIR=./ml/metrics
ML_INPUT_SIZE=224
ML_BINARY_THRESHOLD=0.5
ML_ENSEMBLE_W_BINARY=0.2
ML_ENSEMBLE_W_MULTI=0.3
ML_ENSEMBLE_W_EFFNET=0.5

# Standalone toggle — when true, predict.py runs inference synchronously
# instead of dispatching to Celery.
STANDALONE_MODE=true
