# RetinaX AI — environment template. Copy to .env and fill in.

# ---------- Core ----------
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO

# ---------- Backend / FastAPI ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost
API_V1_PREFIX=/api/v1

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-48-byte-url-safe-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_COOKIE_NAME=retinax_access
JWT_COOKIE_SECURE=false            # true in production (HTTPS only)
JWT_COOKIE_SAMESITE=lax

# ---------- PostgreSQL ----------
POSTGRES_USER=retinax
POSTGRES_PASSWORD=retinax_dev_password
POSTGRES_DB=retinax
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://retinax:retinax_dev_password@postgres:5432/retinax

# ---------- Redis / Celery ----------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---------- Storage ----------
# Local filesystem (default). Switch to s3:// for production object storage.
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/app/storage
STORAGE_PUBLIC_BASE_URL=/storage

# ---------- ML ----------
ML_MODELS_DIR=/app/ml/models
ML_DATA_DIR=/data/colored_images
ML_TRAIN_CSV=/data/train.csv
ML_METRICS_DIR=/app/ml/metrics
ML_INPUT_SIZE=224
ML_BINARY_THRESHOLD=0.5
ML_ENSEMBLE_W_BINARY=0.2
ML_ENSEMBLE_W_MULTI=0.3
ML_ENSEMBLE_W_EFFNET=0.5

# ---------- Frontend (Vite — must be VITE_ prefixed) ----------
VITE_API_BASE_URL=http://localhost/api/v1
